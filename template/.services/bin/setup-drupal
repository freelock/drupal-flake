#!/usr/bin/env bash
#
# setup-drupal: Safely configure a new or existing Drupal project.
#
# Legacy usage remains supported:
#   setup-drupal [DRUPAL_PACKAGE] [PHP_VERSION] [SITE_NAME]
#

set -e

# Source embedded common.sh functions
# (prepended by flake.nix via builtins.readFile concatenation)

usage() {
  cat <<'EOF'
Usage:
  setup-drupal [OPTIONS]
  setup-drupal [DRUPAL_PACKAGE] [PHP_VERSION] [SITE_NAME]

Modes (mutually exclusive):
  --existing             Configure Drupal code already in this directory
  --new                  Create a new Drupal project with Composer

If no mode is supplied, existing Drupal code is detected in DOCROOT, web, or
this directory. Existing code selects --existing; otherwise --new is used.

Options:
  --package PACKAGE      Composer project package (default: drupal/cms)
  --core VERSION         Target Drupal core major (11, 12) or a full constraint
                         (^11.2, 12.0.0-beta1). Implies the core-versioned
                         project template and the PHP version that core needs.
  --php-version VERSION  PHP package name (default: php84)
  --site-name NAME       Project/site name (default: current directory name)
  --port PORT            HTTP port (default: generated from site name)
  --non-interactive      Use defaults instead of prompting
  --force-env            Replace .env from .env.example before filling values
  -h, --help             Show this help

Drupal core:
  --core only applies to --new. A bare major becomes a "^MAJOR" constraint, so
  new point releases are picked up automatically. Drupal core majors at or
  above 12 have no stable release yet; setup-drupal lets Composer install
  pre-releases for them and requires the PHP version those majors need.

Safety:
  --existing refuses to run unless Drupal code is present and never invokes
  Composer. --new refuses to run when Drupal code is already present. Without
  --force-env, existing .env values are preserved and only missing flake-owned
  keys are appended.
EOF
}

fail() {
  echo "Error: $*" >&2
  exit 1
}

require_value() {
  [ $# -ge 2 ] && [ -n "$2" ] || fail "$1 requires a value"
}

MODE=""
DRUPAL_PACKAGE=""
CORE_VERSION=""
PHP_VERSION=""
SITE_NAME=""
PORT=""
NON_INTERACTIVE=false
FORCE_ENV=false
PACKAGE_EXPLICIT=false
TARGET_CONSTRAINT=""
CORE_STABILITY=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    --existing)
      [ "$MODE" != "new" ] || fail "--existing and --new are mutually exclusive"
      MODE="existing"
      shift
      ;;
    --new)
      [ "$MODE" != "existing" ] || fail "--existing and --new are mutually exclusive"
      MODE="new"
      shift
      ;;
    --package)
      require_value "$1" "${2:-}"
      DRUPAL_PACKAGE="$2"
      PACKAGE_EXPLICIT=true
      shift 2
      ;;
    --core)
      require_value "$1" "${2:-}"
      CORE_VERSION="$2"
      shift 2
      ;;
    --php-version)
      require_value "$1" "${2:-}"
      PHP_VERSION="$2"
      shift 2
      ;;
    --site-name)
      require_value "$1" "${2:-}"
      SITE_NAME="$2"
      shift 2
      ;;
    --port)
      require_value "$1" "${2:-}"
      PORT="$2"
      shift 2
      ;;
    --non-interactive)
      NON_INTERACTIVE=true
      shift
      ;;
    --force-env)
      FORCE_ENV=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      while [ $# -gt 0 ]; do
        POSITIONAL+=("$1")
        shift
      done
      ;;
    -*)
      fail "unknown option: $1 (use --help for usage)"
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

[ ${#POSITIONAL[@]} -le 3 ] || fail "too many positional arguments (use --help for usage)"
[ -z "$DRUPAL_PACKAGE" ] || [ -z "${POSITIONAL[0]:-}" ] || fail "package specified both positionally and with --package"
[ -z "$PHP_VERSION" ] || [ -z "${POSITIONAL[1]:-}" ] || fail "PHP version specified both positionally and with --php-version"
[ -z "$SITE_NAME" ] || [ -z "${POSITIONAL[2]:-}" ] || fail "site name specified both positionally and with --site-name"
DRUPAL_PACKAGE="${DRUPAL_PACKAGE:-${POSITIONAL[0]:-}}"
[ -z "${POSITIONAL[0]:-}" ] || PACKAGE_EXPLICIT=true
PHP_VERSION="${PHP_VERSION:-${POSITIONAL[1]:-}}"
SITE_NAME="${SITE_NAME:-${POSITIONAL[2]:-}}"

# The first Drupal core major without a stable release. Majors at or above this
# exist only as pre-releases, so Composer needs a pre-release stability level to
# install them. Bump this when the next major opens.
FIRST_PRERELEASE_CORE=12

# The stability level requested from Composer for a pre-release core. "alpha" is
# the lowest level above "dev": it admits tagged pre-releases on the target line
# but excludes development branches such as 12.0.x-dev, which sort as a higher
# version than the tagged release and would otherwise win the solve. Composer
# records minimum-stability and prefer-stable in the composer.json it generates,
# so later installs stay on tagged releases, and beta or stable are picked up
# automatically as they are released.
PRERELEASE_STABILITY=alpha

# Templates whose own version tracks the Drupal core major. Only these can carry
# the constraint that --core adds; drupal/cms and the Kickstart project are
# versioned independently of core and cannot target a specific core.
is_core_versioned_package() {
  case "$(package_base_name "$1")" in
    drupal/recommended-project|drupal/core-recommended|drupal-composer/drupal-project) return 0 ;;
  esac
  return 1
}

package_base_name() {
  printf '%s' "${1%%:*}"
}

# core_constraint: Map a --core value to a Composer constraint. A bare major
# becomes "^MAJOR" so the newest release on that line is picked up as new point
# releases land; anything already constrained is passed through untouched.
core_constraint() {
  case "$1" in
    *[!0-9.]*) printf '%s' "$1" ;;
    *) printf '^%s' "$1" ;;
  esac
}

core_major() {
  printf '%s' "$1" | sed 's/^[\^~>=<v]*//; s/[^0-9].*$//'
}

# core_is_prerelease: True when the targeted core has no stable release, so
# Composer must be allowed to install pre-release versions.
core_is_prerelease() {
  local constraint="$1"
  case "$constraint" in
    *-alpha*|*-beta*|*-rc*|*-RC*|*-dev*|*-patch*) return 0 ;;
  esac
  local major
  major=$(core_major "$constraint")
  case "$major" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$major" -ge "$FIRST_PRERELEASE_CORE" ]
}

# core_required_php: The PHP package a core major needs. Empty when unknown,
# which leaves the PHP choice entirely to the caller.
core_required_php() {
  case "$(core_major "$1")" in
    12) printf 'php85' ;;
    11) printf 'php83' ;;
    *) printf '' ;;
  esac
}

php_rank() {
  case "$1" in
    php74) printf 74 ;;
    php80) printf 80 ;;
    php81) printf 81 ;;
    php82) printf 82 ;;
    php83) printf 83 ;;
    php84) printf 84 ;;
    php85) printf 85 ;;
    *) printf -1 ;;
  esac
}

ENV_DOCROOT=$(env_file_value DOCROOT || true)
DETECTED_DOCROOT=""

is_drupal_docroot() {
  local candidate="$1"
  local prefix="${candidate%/}"
  [ "$prefix" = "." ] && prefix=""
  [ -f "${prefix:+$prefix/}index.php" ] && [ -d "${prefix:+$prefix/}core" ]
}

for candidate in "$ENV_DOCROOT" web .; do
  [ -n "$candidate" ] || continue
  if is_drupal_docroot "$candidate"; then
    DETECTED_DOCROOT="$candidate"
    break
  fi
done

# Composer-managed Drupal is still an existing project before dependencies have
# been installed. Detect its project metadata so --new can never flatten a
# second project over it.
if [ -z "$DETECTED_DOCROOT" ] && [ -f composer.json ] &&
   grep -qE '"(drupal/core[^"/]*|drupal/cms|drupal/recommended-project|drupal-composer/drupal-project)"' composer.json; then
  DETECTED_DOCROOT="${ENV_DOCROOT:-web}"
fi

if [ -z "$MODE" ]; then
  if [ -n "$DETECTED_DOCROOT" ]; then
    MODE="existing"
  else
    MODE="new"
  fi
fi

if [ "$MODE" = "existing" ] && [ -z "$DETECTED_DOCROOT" ]; then
  fail "--existing requested, but no Drupal code was found in DOCROOT, web, or the project root"
fi
if [ "$MODE" = "new" ] && [ -n "$DETECTED_DOCROOT" ]; then
  fail "--new requested, but Drupal code already exists in '$DETECTED_DOCROOT'"
fi
if [ -n "$CORE_VERSION" ] && [ "$MODE" != "new" ]; then
  fail "--core only applies when creating a new project; drop --core or pass --new"
fi

if [ "$MODE" = "existing" ]; then
  DOCROOT="$DETECTED_DOCROOT"
else
  DOCROOT="${ENV_DOCROOT:-web}"
fi

if [ -z "$SITE_NAME" ]; then
  SITE_NAME=$(env_file_value PROJECT_NAME || true)
fi
if [ -z "$SITE_NAME" ]; then
  DEFAULT_SITE_NAME=$(basename "$(pwd)")
  if [ "$NON_INTERACTIVE" = false ]; then
    echo ""
    read -r -p "Site name [$DEFAULT_SITE_NAME]: " SITE_NAME
  fi
  SITE_NAME="${SITE_NAME:-$DEFAULT_SITE_NAME}"
fi

if [ "$MODE" = "new" ] && [ -z "$DRUPAL_PACKAGE" ]; then
  DRUPAL_PACKAGE=$(env_file_value DRUPAL_PACKAGE || true)
  [ -z "$DRUPAL_PACKAGE" ] || PACKAGE_EXPLICIT=true
fi

# --core picks the core-versioned template, so an explicit package only needs a
# constraint added when it is one of those templates.
if [ "$MODE" = "new" ] && [ -z "$DRUPAL_PACKAGE" ] && [ -n "$CORE_VERSION" ]; then
  DRUPAL_PACKAGE="drupal/recommended-project"
fi
if [ "$MODE" = "new" ] && [ -n "$DRUPAL_PACKAGE" ] && [ -n "$CORE_VERSION" ]; then
  CORE_CONSTRAINT=$(core_constraint "$CORE_VERSION")
  if is_core_versioned_package "$DRUPAL_PACKAGE"; then
    case "$DRUPAL_PACKAGE" in
      *:*) ;; # the caller already pinned a version, so keep theirs
      *) DRUPAL_PACKAGE="$DRUPAL_PACKAGE:$CORE_CONSTRAINT" ;;
    esac
  elif core_is_prerelease "$CORE_CONSTRAINT"; then
    fail "'$DRUPAL_PACKAGE' is versioned independently of Drupal core, so it cannot target core $CORE_VERSION, which has no stable release. Use drupal/recommended-project, or drop --core."
  else
    echo "Note: --core $CORE_VERSION does not constrain '$DRUPAL_PACKAGE'; that package is versioned independently of Drupal core." >&2
  fi
fi

if [ "$MODE" = "new" ] && [ -z "$DRUPAL_PACKAGE" ]; then
  if [ "$NON_INTERACTIVE" = false ]; then
    echo "Select a starting package:"
    echo "  1) drupal/cms (Drupal CMS - stable)"
    echo "  2) drupal/recommended-project:^11 (Drupal core - stable)"
    echo "  3) centarro/commerce-kickstart-project (Commerce Kickstart - stable)"
    echo "  4) drupal/recommended-project:^12 (Drupal core NEXT - pre-release, needs PHP 8.5)"
    echo "  5) Other (enter custom package name)"
    read -r -p "Choice [1]: " choice
    case "${choice:-1}" in
      1|"") DRUPAL_PACKAGE="drupal/cms" ;;
      2) DRUPAL_PACKAGE="drupal/recommended-project:^11" ;;
      3) DRUPAL_PACKAGE="centarro/commerce-kickstart-project" ;;
      4) DRUPAL_PACKAGE="drupal/recommended-project:^12" ;;
      5)
        read -r -p "Enter composer package name: " DRUPAL_PACKAGE
        DRUPAL_PACKAGE="${DRUPAL_PACKAGE:-drupal/cms}"
        ;;
      *) echo "Invalid choice, using default: drupal/cms"; DRUPAL_PACKAGE="drupal/cms" ;;
    esac
  else
    DRUPAL_PACKAGE="drupal/cms"
  fi
fi

# Whatever produced the constraint -- --core, .env, or a prompt answer -- a
# constraint naming a major without a stable release means Composer has to be
# allowed to install pre-releases. The inline stability flag is appended as well
# so the DRUPAL_PACKAGE value keeps working wherever else it is used.
case "$DRUPAL_PACKAGE" in
  *:*) TARGET_CONSTRAINT="${DRUPAL_PACKAGE#*:}" ;;
esac
if [ -n "$TARGET_CONSTRAINT" ] && core_is_prerelease "$TARGET_CONSTRAINT"; then
  CORE_STABILITY="$PRERELEASE_STABILITY"
  case "$DRUPAL_PACKAGE" in
    *@*) ;;
    *) DRUPAL_PACKAGE="$DRUPAL_PACKAGE@$PRERELEASE_STABILITY" ;;
  esac
fi

# PHP is chosen after the package because the core decides which versions are
# usable. Only versions the core supports are offered, and when just one
# qualifies (Drupal 12 needs PHP 8.5) it is selected without a prompt.
REQUIRED_PHP=$(core_required_php "$TARGET_CONSTRAINT")
if [ -z "$PHP_VERSION" ]; then
  PHP_VERSION=$(env_file_value PHP_VERSION || true)
fi
if [ -z "$PHP_VERSION" ]; then
  PHP_CHOICES=()
  for candidate in php84 php85 php83; do
    if [ -z "$REQUIRED_PHP" ] || [ "$(php_rank "$candidate")" -ge "$(php_rank "$REQUIRED_PHP")" ]; then
      PHP_CHOICES+=("$candidate")
    fi
  done
  [ ${#PHP_CHOICES[@]} -gt 0 ] || fail "no supported PHP version satisfies Drupal core $TARGET_CONSTRAINT"

  if [ ${#PHP_CHOICES[@]} -eq 1 ]; then
    PHP_VERSION="${PHP_CHOICES[0]}"
    echo "Using $PHP_VERSION, the PHP version Drupal core $TARGET_CONSTRAINT needs"
  elif [ "$NON_INTERACTIVE" = false ]; then
    echo ""
    echo "Select PHP version:"
    for i in "${!PHP_CHOICES[@]}"; do
      label=""
      [ "$i" -ne 0 ] || label=" (default)"
      echo "  $((i + 1))) ${PHP_CHOICES[$i]}$label"
    done
    read -r -p "Choice [1]: " choice
    choice="${choice:-1}"
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#PHP_CHOICES[@]} ]; then
      PHP_VERSION="${PHP_CHOICES[$((choice - 1))]}"
    else
      echo "Invalid choice, using default: ${PHP_CHOICES[0]}"
      PHP_VERSION="${PHP_CHOICES[0]}"
    fi
  else
    PHP_VERSION="${PHP_CHOICES[0]}"
  fi
fi

if [ -z "$PORT" ]; then
  PORT=$(env_file_value PORT || true)
fi
if [ -z "$PORT" ]; then
  PORT=$(generate_port "$SITE_NAME")
  if [ "$NON_INTERACTIVE" = false ]; then
    read -r -p "Port [$PORT]: " PORT_INPUT
    PORT="${PORT_INPUT:-$PORT}"
  fi
fi

if [ "$FORCE_ENV" = false ]; then
  ENV_PROJECT_NAME=$(env_file_value PROJECT_NAME || true)
  ENV_PHP_VERSION=$(env_file_value PHP_VERSION || true)
  ENV_PORT=$(env_file_value PORT || true)
  SITE_NAME="${ENV_PROJECT_NAME:-$SITE_NAME}"
  PHP_VERSION="${ENV_PHP_VERSION:-$PHP_VERSION}"
  PORT="${ENV_PORT:-$PORT}"
  DOMAIN=$(env_file_value DOMAIN || true)
else
  DOMAIN=""
fi
DOMAIN="${DOMAIN:-${SITE_NAME}.ddev.site}"

if ! echo "$SITE_NAME" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9_-]*$'; then
  fail "invalid site name '$SITE_NAME'; use letters, numbers, underscores, and hyphens"
fi
case "$PHP_VERSION" in
  php74|php81|php82|php83|php84|php85) ;;
  *) fail "unsupported PHP version: $PHP_VERSION" ;;
esac

# A PHP version supplied by flag or .env is not filtered by the menu, so check
# it against the core here; Composer would otherwise fail later with a far less
# obvious solver message.
if [ -n "$REQUIRED_PHP" ] && [ "$(php_rank "$PHP_VERSION")" -lt "$(php_rank "$REQUIRED_PHP")" ]; then
  fail "Drupal core $TARGET_CONSTRAINT requires PHP $REQUIRED_PHP or newer, but PHP $PHP_VERSION was requested"
fi

if ! echo "$PORT" | grep -qE '^[0-9]+$' || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  fail "invalid port: $PORT"
fi

echo ""
echo "========================================="
echo "Setting up Drupal project"
echo "  Mode:        $MODE"
[ "$MODE" = "new" ] && echo "  Package:     $DRUPAL_PACKAGE"
[ -n "$TARGET_CONSTRAINT" ] && echo "  Core:        $TARGET_CONSTRAINT"
[ -n "$CORE_STABILITY" ] && echo "  Stability:   $CORE_STABILITY (core has no stable release)"
echo "  PHP:         $PHP_VERSION"
echo "  Site name:   $SITE_NAME"
echo "  Docroot:     $DOCROOT"
echo "  Port:        $PORT"
echo "========================================="
echo ""

if [ "$MODE" = "new" ]; then
  TEMP_DIR=".setup-drupal-tmp-$$"
  ENV_BACKUP=""
  if [ -f .env ] && [ "$FORCE_ENV" = false ]; then
    ENV_BACKUP=$(mktemp)
    cp .env "$ENV_BACKUP"
  fi

  cleanup_setup_drupal() {
    rm -rf "$TEMP_DIR" 2>/dev/null || true
    [ -z "$ENV_BACKUP" ] || rm -f "$ENV_BACKUP"
  }
  trap cleanup_setup_drupal EXIT

  echo "Running composer create-project..."
  echo "  $DRUPAL_PACKAGE -> $TEMP_DIR"
  # A pre-release core needs Composer allowed to install pre-releases. The level
  # matters: "dev" would also admit development branches, which carry a higher
  # version than the tagged release and would win the solve. Note that
  # create-project does not accept --prefer-stable; Composer writes that into the
  # generated composer.json itself.
  CREATE_OPTS=(--no-interaction)
  [ -z "$CORE_STABILITY" ] || CREATE_OPTS+=(--stability="$CORE_STABILITY")
  if ! composer create-project "$DRUPAL_PACKAGE" "$TEMP_DIR" "${CREATE_OPTS[@]}" 2>&1; then
    fail "composer create-project failed"
  fi

  flatten_subdirectory "$TEMP_DIR"

  if [ -n "$ENV_BACKUP" ]; then
    cp "$ENV_BACKUP" .env
  fi

  write_env_from_example "$SITE_NAME" "$PHP_VERSION" "$PORT" "$DOCROOT" "$FORCE_ENV"

  echo ""
  echo "Running composer install..."
  composer install 2>&1 || echo "composer install completed with warnings"
else
  write_env_from_example "$SITE_NAME" "$PHP_VERSION" "$PORT" "$DOCROOT" "$FORCE_ENV"
fi

DOCROOT_PREFIX="${DOCROOT%/}"
[ "$DOCROOT_PREFIX" = "." ] && DOCROOT_PREFIX=""
SETTINGS_FILE="${DOCROOT_PREFIX:+$DOCROOT_PREFIX/}sites/default/settings.php"

if [ ! -f "$SETTINGS_FILE" ]; then
  echo ""
  echo "Generating settings.php..."
  command -v setup-settings >/dev/null 2>&1 || fail "setup-settings not found in PATH"
  setup-settings --project-name "$SITE_NAME" --docroot "$DOCROOT"
fi

command -v nix-settings >/dev/null 2>&1 || fail "nix-settings not found in PATH"
PROJECT_ROOT_REL=""
DOCROOT_REMAINDER="${DOCROOT#./}"
DOCROOT_REMAINDER="${DOCROOT_REMAINDER%/}"
if [ -z "$DOCROOT_REMAINDER" ] || [ "$DOCROOT_REMAINDER" = "." ]; then
  PROJECT_ROOT_REL="."
else
  while [ -n "$DOCROOT_REMAINDER" ]; do
    PROJECT_ROOT_REL="../$PROJECT_ROOT_REL"
    case "$DOCROOT_REMAINDER" in
      */*) DOCROOT_REMAINDER="${DOCROOT_REMAINDER#*/}" ;;
      *) DOCROOT_REMAINDER="" ;;
    esac
  done
  PROJECT_ROOT_REL="${PROJECT_ROOT_REL%/}"
fi
nix-settings "$SITE_NAME" "$DOCROOT" "" "$PROJECT_ROOT_REL"

if git rev-parse --is-inside-work-tree 2>/dev/null && [ -f .env ]; then
  git add .env 2>/dev/null || true
  echo "Added .env to git staging (required for MySQL socket to work)"
fi

export PROJECT_NAME="$SITE_NAME"
export PHP_VERSION PORT DOMAIN DOCROOT

echo ""
echo "========================================="
echo "✅ Setup complete!"
echo "========================================="
echo ""
echo "Mode:          $MODE"
[ "$MODE" = "new" ] && echo "Package:       $DRUPAL_PACKAGE"
[ -n "$TARGET_CONSTRAINT" ] && echo "Core:          $TARGET_CONSTRAINT"
echo "Site name:     $SITE_NAME"
echo "PHP version:   $PHP_VERSION"
echo "Docroot:       $DOCROOT"
echo "Port:          $PORT"
echo "URL:           http://${DOMAIN}:${PORT}"
echo ""
[ -n "$CORE_STABILITY" ] && echo "⚠️  This project targets a Drupal core that has no stable release yet."
echo ""

if [ -n "${DIRENV_DIR:-}" ]; then
  echo "📌 Direnv detected — run 'direnv reload' to pick up new .env values."
else
  echo "📌 Run 'exit' then 'nix develop' to pick up the new .env values."
fi
echo "   Then run 'start-detached' to start the development environment."
